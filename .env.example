# Template for the .env file. Never commit a real token (.env is git-ignored).
# The file is read automatically from the workspace, the current directory and the project root.

# --- Hugging Face upload -------------------------------------------------------------
# Access token with write permission (https://huggingface.co/settings/tokens)
HF_TOKEN=
# Dataset repository as username/dataset-name. Setting this turns the upload on.
HF_DATASET_REPO=
# Optional
# HF_PRIVATE=false          # false = public repository
# HF_MIN_SIZE_MB=1024       # upload only once the output folder is at least this big
# HF_UPLOAD_ENABLED=true    # set false to pause uploading without removing the values above


# Workspace used by `image-pipeline` and the API when --workspace is not given (default: current directory)
# IMAGE_PIPELINE_WORKSPACE=./workspace

# Optional database URL instead of the workspace SQLite file (PostgreSQL is untested)
# IMAGE_PIPELINE_DATABASE_URL=

# DEBUG | INFO | WARNING
# IMAGE_PIPELINE_LOG_LEVEL=INFO
